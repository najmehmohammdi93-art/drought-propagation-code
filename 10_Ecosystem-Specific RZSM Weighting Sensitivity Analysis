# =========================================================================
# Script 10: Ecosystem-Specific RZSM Weighting Sensitivity Analysis
#
# Purpose:
#   Evaluate whether reasonable changes in the ecosystem-specific soil
#   moisture weighting factors affect drought propagation results.
#
# For each scenario:
#   1. Reconstruct ecosystem-specific RZSM
#   2. Calculate 3-month RZSM
#   3. Calculate SSMI3
#   4. Calculate ecosystem-specific NDVI anomalies
#   5. Calculate lagged correlations for lags 0-12 months
#   6. Extract peak correlation and dominant lag
#
# Study period:
#   2000-2025
#
# Evaluation period:
#   2015-2025
#
# Ecosystems:
#   Forest
#   Grassland
#   Cropland
#
# Output:
#   Table 1-style sensitivity results
#
# =========================================================================


import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import rioxarray as rxr
from scipy.stats import pearsonr


# -------------------------------------------------------------------------
# 1. Load the three ERA5-Land soil moisture layers
# -------------------------------------------------------------------------

print("Loading ERA5-Land soil moisture layers...")


sm1_stack = rxr.open_rasterio(
    "Iran_SM_Layer1_312months.tif"
)

sm2_stack = rxr.open_rasterio(
    "Iran_SM_Layer2_312months.tif"
)

sm3_stack = rxr.open_rasterio(
    "Iran_SM_Layer3_312months.tif"
)


# -------------------------------------------------------------------------
# IMPORTANT:
#
# If the three individual soil-layer files do not exist, export them from
# Google Earth Engine using Script 01 or modify this section to load the
# original three-layer data source.
# -------------------------------------------------------------------------


# -------------------------------------------------------------------------
# 2. Load NDVI anomaly and ecosystem mask
# -------------------------------------------------------------------------

ndvi_stack = rxr.open_rasterio(
    "Iran_NDVI_Anom_312months.tif"
)

ecosystem_mask = rxr.open_rasterio(
    "Iran_Ecosystem_Mask.tif"
).isel(band=0)


# -------------------------------------------------------------------------
# 3. Define monthly timeline
# -------------------------------------------------------------------------

timeline = pd.date_range(
    start="2000-01-01",
    end="2025-12-01",
    freq="MS"
)


for stack, name in [
    (sm1_stack, "soil layer 1"),
    (sm2_stack, "soil layer 2"),
    (sm3_stack, "soil layer 3"),
    (ndvi_stack, "NDVI")
]:

    if stack.sizes["band"] != len(timeline):

        raise ValueError(
            f"{name} does not contain 312 monthly observations."
        )


# -------------------------------------------------------------------------
# 4. Assign time dimension
# -------------------------------------------------------------------------

sm1_stack = (
    sm1_stack
    .assign_coords(band=timeline)
    .rename({"band": "time"})
)

sm2_stack = (
    sm2_stack
    .assign_coords(band=timeline)
    .rename({"band": "time"})
)

sm3_stack = (
    sm3_stack
    .assign_coords(band=timeline)
    .rename({"band": "time"})
)

ndvi_stack = (
    ndvi_stack
    .assign_coords(band=timeline)
    .rename({"band": "time"})
)


# -------------------------------------------------------------------------
# 5. Ecosystem definitions
#
# These IDs must match Script 01.
# -------------------------------------------------------------------------

ECOSYSTEMS = {
    "Forest": 1,
    "Grassland": 3,
    "Cropland": 4
}


# -------------------------------------------------------------------------
# 6. Weighting scenarios
#
# Each triplet represents:
#
#   [0-7 cm, 7-28 cm, 28-100 cm]
#
# Baseline values are those used in the main analysis.
# -------------------------------------------------------------------------

