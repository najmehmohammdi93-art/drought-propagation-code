# -------------------------------------------------------------------------
# 7. Check that all weights sum to one
# -------------------------------------------------------------------------

for scenario, weights in SCENARIOS.items():

    for ecosystem, w in weights.items():

        if not np.isclose(
            sum(w),
            1.0
        ):

            raise ValueError(
                f"Weights for {scenario} - {ecosystem} "
                f"do not sum to 1."
            )


# -------------------------------------------------------------------------
# 8. Calculate ecosystem-specific weighted RZSM
# -------------------------------------------------------------------------

def calculate_ecosystem_rzsm(
    weights,
    ecosystem,
    ecosystem_id
):

    w1, w2, w3 = weights

    mask = (
        ecosystem_mask == ecosystem_id
    )

    rzsm = (
        sm1_stack.multiply(w1)
        .add(
            sm2_stack.multiply(w2)
        )
        .add(
            sm3_stack.multiply(w3)
        )
    )

    rzsm = rzsm.where(
        mask
    )

    return rzsm


# -------------------------------------------------------------------------
# 9. Calculate SSMI3
#
# Calendar-month standardization is applied to the 3-month RZSM.
# -------------------------------------------------------------------------

def calculate_ssmi3(
    rzsm
):

    rzsm_3m = (
        rzsm
        .rolling(
            time=3,
            center=False,
            min_periods=3
        )
        .mean()
    )


    monthly_mean = (
        rzsm_3m
        .groupby("time.month")
        .mean(
            "time",
            skipna=True
        )
    )


    monthly_std = (
        rzsm_3m
        .groupby("time.month")
        .std(
            "time",
            skipna=True
        )
    )


    ssmi3 = (
        (
            rzsm_3m
            .groupby("time.month")
            -
            monthly_mean
        )
        /
        monthly_std
    )


    ssmi3 = ssmi3.drop_vars(
        "month",
        errors="ignore"
    )

    return ssmi3


# -------------------------------------------------------------------------
# 10. Extract spatially averaged ecosystem time series
# -------------------------------------------------------------------------

def spatial_mean(
    data
):

    return (
        data
        .mean(
            dim=["y", "x"],
            skipna=True
        )
        .to_pandas()
    )


# -------------------------------------------------------------------------
# 11. Extract NDVI ecosystem time series
# -------------------------------------------------------------------------

def get_ndvi_series(
    ecosystem_id
):

    mask = (
        ecosystem_mask == ecosystem_id
    )

    ndvi = ndvi_stack.where(
        mask
    )

    return spatial_mean(
        ndvi
    )


# -------------------------------------------------------------------------
# 12. Lagged Pearson correlation
# -------------------------------------------------------------------------

def lagged_correlations(
    forcing,
    response,
    max_lag=12
):

    combined = pd.concat(
        [
            forcing.rename("Forcing"),
            response.rename("Response")
        ],
        axis=1
    ).dropna()


    forcing = combined["Forcing"]
    response = combined["Response"]


    r_values = []


    for lag in range(
        max_lag + 1
    ):

        if lag == 0:

            x = forcing
            y = response

        else:

            x = forcing.iloc[:-lag]
            y = response.iloc[lag:]


        valid = (
            np.isfinite(x.values)
            &
            np.isfinite(y.values)
        )


        x = x.values[valid]
        y = y.values[valid]


        if len(x) < 3:

            r_values.append(
                np.nan
            )

            continue


        if (
            np.std(x) == 0
            or np.std(y) == 0
        ):

            r_values.append(
                np.nan
            )

            continue


        r, _ = pearsonr(
            x,
            y
        )


        r_values.append(
            r
        )


    return np.asarray(
        r_values,
        dtype=float
    )


# -------------------------------------------------------------------------
# 13. Prepare NDVI series
# -------------------------------------------------------------------------

print("Extracting ecosystem NDVI anomaly series...")


ndvi_series = {

    ecosystem: get_ndvi_series(
        ecosystem_id
    )

    for ecosystem, ecosystem_id
    in ECOSYSTEMS.items()
}


# -------------------------------------------------------------------------
# 14. Run all weighting scenarios
# -------------------------------------------------------------------------

results = []


for scenario_name, scenario_weights in SCENARIOS.items():

    print(
        f"\nProcessing scenario: {scenario_name}"
    )


    for ecosystem, ecosystem_id in ECOSYSTEMS.items():

        print(
            f"  {ecosystem}"
        )


        # -------------------------------------------------------------
        # Calculate weighted RZSM
        # -------------------------------------------------------------

        rzsm = calculate_ecosystem_rzsm(
            scenario_weights[ecosystem],
            ecosystem,
            ecosystem_id
        )


        # -------------------------------------------------------------
        # Calculate SSMI3
        # -------------------------------------------------------------

        ssmi3 = calculate_ssmi3(
            rzsm
        )


        ssmi3_series = spatial_mean(
            ssmi3
        )


        # -------------------------------------------------------------
        # Evaluation period
        # -------------------------------------------------------------

        ssmi3_eval = (
            ssmi3_series
            .loc[
                "2015-01-01":
                "2025-12-01"
            ]
        )


        ndvi_eval = (
            ndvi_series[ecosystem]
            .loc[
                "2015-01-01":
                "2025-12-01"
            ]
        )


        # -------------------------------------------------------------
        # Lagged correlation
        # -------------------------------------------------------------

        r_values = lagged_correlations(
            ssmi3_eval,
            ndvi_eval,
            max_lag=12
        )


        lags = np.arange(
            0,
            13
        )


        # -------------------------------------------------------------
        # Peak correlation
        # -------------------------------------------------------------

        peak_index = np.nanargmax(
            r_values
        )


        peak_r = (
            r_values[
                peak_index
            ]
        )


        peak_lag = (
            lags[
                peak_index
            ]
        )


        # -------------------------------------------------------------
        # Save result
        # -------------------------------------------------------------

        w1, w2, w3 = (
            scenario_weights[
                ecosystem
            ]
        )


        results.append(
            {

                "Scenario":
                    scenario_name,

                "Ecosystem":
                    ecosystem,

                "Weight_0_7cm":
                    w1,

                "Weight_7_28cm":
                    w2,

                "Weight_28_100cm":
                    w3,

                "Peak_r":
                    peak_r,

                "Dominant_lag_months":
                    peak_lag

            }
        )


        print(
            f"    Peak r = {peak_r:.6f}; "
            f"Lag = {peak_lag} months"
        )


# -------------------------------------------------------------------------
# 15. Create results table
# -------------------------------------------------------------------------

results_df = pd.DataFrame(
    results
)


# -------------------------------------------------------------------------
# 16. Add change relative to baseline
# -------------------------------------------------------------------------

baseline_df = (
    results_df[
        results_df["Scenario"] == "Baseline"
    ]
    [
        [
            "Ecosystem",
            "Peak_r",
            "Dominant_lag_months"
        ]
    ]
    .rename(
        columns={
            "Peak_r":
                "Baseline_Peak_r",

            "Dominant_lag_months":
                "Baseline_lag"
        }
    )
)


results_df = results_df.merge(
    baseline_df,
    on="Ecosystem",
    how="left"
)


results_df["Delta_r"] = (
    results_df["Peak_r"]
    -
    results_df["Baseline_Peak_r"]
)


results_df["Lag_change_months"] = (
    results_df["Dominant_lag_months"]
    -
    results_df["Baseline_lag"]
)


results_df["Absolute_Delta_r"] = (
    results_df["Delta_r"].abs()
)


